PORT=3000
PUBLIC_BASE_URL=https://gateway.example.com
MONGODB_URI=mongodb://127.0.0.1:27017/wa_gateway?replicaSet=rs0

# Generate independent random values of at least 32 bytes.
JWT_SECRET=
API_KEY_ENCRYPTION_SECRET=
API_SECRET_KEY=
# Optional backward-compatible per-client keys as JSON.
CLIENT_API_KEYS={}

# Optional initial admin; configure all three before first production boot.
ADMIN_NAME=
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_PHONE=
JWT_EXPIRES_IN=12h

PLAN_BASIC_USD=
PLAN_PRO_USD=
SUBSCRIPTION_DURATION_DAYS=30
PAYMENT_VES_PER_USD=

PAGO_MOVIL_BANK=
PAGO_MOVIL_BANK_CODE=
PAGO_MOVIL_PHONE=
PAGO_MOVIL_ID=
PAGO_MOVIL_HOLDER=
# Optional; otherwise the QR encodes gateway JSON, not a bank-standard payment QR.
PAGO_MOVIL_QR_PAYLOAD=

FACEBANK_ROUTING_NUMBER=
FACEBANK_ACCOUNT_NUMBER=
FACEBANK_ACCOUNT_HOLDER=
PIPOL_PAY_EMAIL=
FACEBANK_PAYMENT_INSTRUCTIONS=

BINANCE_PAY_API_BASE=https://bpay.binanceapi.com
BINANCE_PAY_API_KEY=
BINANCE_PAY_CERTIFICATE_SERIAL=
BINANCE_PAY_PRIVATE_KEY=
BINANCE_PAY_PUBLIC_KEY=
BINANCE_PAY_WEBHOOK_CERTIFICATE_SERIAL=

PAYPAL_API_BASE=https://api-m.paypal.com
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=

# Existing authenticated Baileys instance used to send welcome notifications.
SYSTEM_WHATSAPP_CLIENT_ID=
